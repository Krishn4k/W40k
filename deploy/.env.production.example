# Modèle du .env de production (OVH, krishnak.fr/w40k).
# Copier en w40k-app/.env sur l'hébergement et remplir les valeurs vides.
# Ce fichier ne contient aucun secret ; le vrai .env ne doit jamais être versionné.

APP_NAME="W40k Collection"
APP_ENV=production
# Clé générée une seule fois sur ton PC : php artisan key:generate --show (à coller ici, puis ne plus la changer).
APP_KEY=
APP_DEBUG=false
APP_URL=https://krishnak.fr/w40k

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Base MySQL de l'hébergement (onglet « Bases de données » de l'espace client OVH), partagée avec WordPress :
# toutes les tables de l'application portent le préfixe w40k_ (celles de WordPress commencent par wp_).
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=w40k_

# Cookie de session limité à l'application, envoyé uniquement en https.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/w40k
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Aucun processus permanent sur l'offre Perso : les tâches éventuelles s'exécutent immédiatement.
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="w40k@krishnak.fr"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
